# Copy to .env next to docker-compose.yml. .env is gitignored.

POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=change-me

# The edge nginx port on the host; the only port out of the compose network.
EDGE_PORT=8080

# Tests run on the host against the test database. Never point this at
# POSTGRES_DB — conftest refuses any database not ending in _test.
TEST_DATABASE_URL=postgresql+psycopg://agentops:change-me@127.0.0.1:5532/agentops_test

# The seed agent's permanent key; seed.py hashes it before storing.
SEED_AGENT_KEY=change-me-seed
